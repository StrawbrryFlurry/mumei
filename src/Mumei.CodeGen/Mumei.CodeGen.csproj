<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <MumeiInternalApiDiagnostic>MOOM9999</MumeiInternalApiDiagnostic>
        <NoWarn>RS2008,$(MumeiInternalApiDiagnostic)</NoWarn>

        <TargetFramework>net9.0</TargetFramework>
        <LangVersion>Latest</LangVersion>
        <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
        <EnforceExtendedAnalyzerRules>true</EnforceExtendedAnalyzerRules>
    </PropertyGroup>

    <ItemGroup>
        <InternalsVisibleTo Include="Mumei.CodeGen.Roslyn"/>
        <InternalsVisibleTo Include="Mumei.Roslyn.Testing"/>
        <InternalsVisibleTo Include="Mumei.CodeGen.DeclarationGenerator"/>
    </ItemGroup>

    <ItemGroup>
        <Using Include="System.Collections.Immutable"/>
    </ItemGroup>

    <Import Project="../Mumei.Roslyn.Common/Mumei.Roslyn.Common.props"/>
    <Import Project="../Mumei.Common.Internal/Mumei.Common.Internal.props"/>

    <PropertyGroup>
        <GetTargetPathDependsOn>$(GetTargetPathDependsOn);GetDependencyTargetPaths</GetTargetPathDependsOn>
    </PropertyGroup>

    <Target Name="GetDependencyTargetPaths" AfterTargets="ResolvePackageDependenciesForBuild">
        <ItemGroup>
        </ItemGroup>
    </Target>
</Project>