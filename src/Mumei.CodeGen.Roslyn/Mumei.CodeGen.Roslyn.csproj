<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <MumeiInternalApiDiagnostic>MOOM9999</MumeiInternalApiDiagnostic>

        <TargetFramework>net10.0</TargetFramework>
        <LangVersion>preview</LangVersion>
        <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
        <EnforceExtendedAnalyzerRules>true</EnforceExtendedAnalyzerRules>

        <NoWarn>RS2008,$(MumeiInternalApiDiagnostic)</NoWarn>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.CodeAnalysis.CSharp"/>
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\Mumei.CodeGen\Mumei.CodeGen.csproj"/>
    </ItemGroup>

    <ItemGroup>
        <InternalsVisibleTo Include="Mumei.CodeGen.DeclarationGenerator"/>
        <InternalsVisibleTo Include="Mumei.Roslyn.Testing"/>
    </ItemGroup>
</Project>